<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Company>Brim</Company>
    <Product>Brim</Product>
    <Version>2.6.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Gemeinsame Windows-Zielplattform: gebaut gegen 22621 (Windows 11 22H2, für die Fokus-Sitzung), läuft dank
         TargetPlatformMinVersion 19041 weiter auf Windows 10 22H2. Neuere Schnittstellen nur mit ApiInformation-Prüfung. -->
    <BrimWindowsTfm>net10.0-windows10.0.22621.0</BrimWindowsTfm>
  </PropertyGroup>
</Project>
