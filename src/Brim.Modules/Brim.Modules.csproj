<Project Sdk="Microsoft.NET.Sdk">
  <!-- Eingebaute Module. Nutzen Windows-Schnittstellen, aber kein WinUI: Oberfläche nur über Brim.Core.Widgets. -->
  <PropertyGroup>
    <TargetFramework>$(BrimWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Brim.Modules</RootNamespace>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- DNS-SD-Strukturen sind architekturabhängig; x64 und ARM64 haben dasselbe 64-Bit-Layout. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="libsodium" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Brim.Core\Brim.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Brim.Modules.Tests" />
  </ItemGroup>
</Project>
