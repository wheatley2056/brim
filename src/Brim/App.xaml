<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Brim.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kein festes Design: Einstellungsfenster und Tray-Menü folgen Hell/Dunkel des Systems.
         Die Notch selbst ist immer dunkel (RequestedTheme in NotchView.xaml). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Shell/NotchResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
