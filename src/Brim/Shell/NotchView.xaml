<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Brim.Shell.NotchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <!-- Zeichenfläche: Form im Compositor (ShapeHost), darüber die Inhaltsebenen, beschnitten auf die Form. -->
    <Grid x:Name="CanvasRoot" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent">
        <Grid x:Name="ShapeHost" IsHitTestVisible="False" />

        <Grid x:Name="ContentHost">
            <!-- Ruhe: nur die Uhrzeit -->
            <Grid x:Name="IdleLayer" Width="180" Height="30"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Visibility="Collapsed">

            </Grid>

            <!-- Kompakt: links und rechts je ein Slot -->
            <Grid x:Name="CompactLayer" Width="300" Height="34" Padding="14,0,16,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Visibility="Collapsed">
                <ContentPresenter x:Name="LeadingPresenter" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <ContentPresenter x:Name="TrailingPresenter" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- HUD: eine Zeile, z. B. Lautstärke -->
            <Grid x:Name="HudLayer" Width="300" Height="34"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Visibility="Collapsed">
                <ContentPresenter x:Name="HudPresenter" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
            </Grid>

            <!-- Kritischer Hinweis -->
            <Grid x:Name="AlertLayer" Width="480" Height="88" Padding="22,10,18,14"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Visibility="Collapsed">
                <ContentPresenter x:Name="AlertPresenter" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
            </Grid>

            <!-- Ablegen: erscheint, während etwas über die Notch gezogen wird -->
            <Grid x:Name="DropLayer" Width="352" Height="88" Padding="14,10,14,14"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Visibility="Collapsed">
                <Rectangle x:Name="DropOutline" RadiusX="16" RadiusY="16"
                           Stroke="#FF5A5D66" StrokeThickness="1.5" StrokeDashArray="4,3" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon x:Name="DropIcon" FontFamily="{StaticResource NotchIconFont}" FontSize="16" Foreground="{StaticResource FogBrush}" />
                    <TextBlock x:Name="DropText" Text="Loslassen, um es in der Ablage zu behalten"
                               FontSize="14" Foreground="{StaticResource FogBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Erweitert: Tabs und Inhalt -->
            <Grid x:Name="ExpandedLayer" Width="620" Height="248" Padding="24,14,24,18" RowSpacing="16"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Segmentierte Tabs: Spur 30 px hoch, Auswahl gleitet als Pille (Compositor). -->
                <Grid x:Name="HeaderRow" Height="30">
                    <Border Background="{StaticResource TabTrackBrush}" CornerRadius="15" Padding="3" HorizontalAlignment="Left">
                        <Grid>
                            <Grid x:Name="TabIndicatorHost" IsHitTestVisible="False" />
                            <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="2"
                                        AutomationProperties.Name="Brim-Bereiche">
                                <Button x:Name="TabNow" Style="{StaticResource NotchTabStyle}" Content="Jetzt" Tag="Now" Click="OnTabClick" />
                                <Button x:Name="TabShelf" Style="{StaticResource NotchTabStyle}" Content="Ablage" Tag="Shelf" Click="OnTabClick" />
                                <Button x:Name="TabSystem" Style="{StaticResource NotchTabStyle}" Content="System" Tag="System" Click="OnTabClick" />
                                <Button x:Name="TabPlugins" Style="{StaticResource NotchTabStyle}" Content="Plugins" Tag="Plugins" Click="OnTabClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <ContentPresenter x:Name="NowPresenter" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <ContentPresenter x:Name="ShelfPresenter" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
                    <!-- Tab „System“: Karten der Module in zwei Spalten (NotchView.System.cs). -->
                    <Grid x:Name="SystemPanel" ColumnSpacing="16" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SystemMainColumn" Width="328" />
                            <ColumnDefinition x:Name="SystemSideColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="SystemMain" RowSpacing="10" />
                        <Grid x:Name="SystemSide" Grid.Column="1" RowSpacing="8" />
                    </Grid>
                    <StackPanel x:Name="PlaceholderPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                        <FontIcon x:Name="PlaceholderIcon" FontFamily="{StaticResource NotchIconFont}" FontSize="22" Foreground="{StaticResource SlateBrush}" />
                        <TextBlock x:Name="PlaceholderTitle" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FogBrush}" />
                        <TextBlock x:Name="PlaceholderText" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource SlateBrush}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Weichzeichner für Inhaltswechsel (Win2D), auf die Form beschnitten. -->
        <Grid x:Name="BlurHost" IsHitTestVisible="False" />

        <!-- Die Uhr ist ein gemeinsames Element: Sie wandert zwischen Ruhezustand und Kopfzeile,
             statt in einer Ebene zu verschwinden und in der anderen aufzutauchen. Über der Unschärfe,
             damit sie während des Wechsels scharf bleibt. -->
        <Grid x:Name="ClockHost" IsHitTestVisible="False">
            <TextBlock x:Name="SharedClock"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       FontFamily="{StaticResource NotchMonoFont}" FontSize="13"
                       Foreground="{StaticResource FogBrush}"
                       TextLineBounds="Tight" />
        </Grid>

        <!-- Inhalt der Perlen liegt außerhalb des Clips des Körpers. -->
        <Canvas x:Name="BeadHost" IsHitTestVisible="False" />
    </Grid>
</UserControl>
