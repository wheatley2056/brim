<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plugin für SwyxIt! (Enreach): eingehende Anrufe mit Annehmen/Ablehnen, laufende Gespräche, Chat-Nachrichten.
    Spricht die Client-Line-Manager-COM-Schnittstelle von SwyxIt! (Swyx.Client.ClmgrAPI) und Brim über Brim.Sdk.
    Build-Ausgabe ist der fertige Plugin-Ordner.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(BrimWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BrimSwyxIt</AssemblyName>
    <RootNamespace>Brim.SwyxIt</RootNamespace>
    <!-- Die Interop-Assembly gibt es nur für x86 und x64. -->
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swyx.Client.ClmgrAPI" />
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Brim.Sdk\Brim.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
